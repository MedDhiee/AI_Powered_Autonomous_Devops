# Global default provider for all LLM calls
LLM_PROVIDER=openrouter

# Per-component provider override (optional)
# ARCH_LLM_PROVIDER=openrouter
# DEVSECOPS_LLM_PROVIDER=openrouter
# JUDGE_LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_JUDGE_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_JUDGE_FALLBACK_MODELS=

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_JUDGE_MODEL=llama-3.1-8b-instant


# Optional runtime tuning
DEVSECOPS_LLM_TEMPERATURE=0.7
LLM_JUDGE_MAX_RETRIES=3
LLM_JUDGE_RETRY_DELAY_SEC=2

# Optional: point to a non-default env file
# ENV_FILE=.env

# Ollama
LLM_PROVIDER=openrouter
DEVSECOPS_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=abdc8f6bf84541b1ab711e038c24a947.QlbBAx8xYEACnh7iRI_ZfevG
OLLAMA_MODEL=minimax-m2.7:cloud
