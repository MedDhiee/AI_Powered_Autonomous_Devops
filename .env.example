# Global default provider for all LLM calls
LLM_PROVIDER=openrouter

# Per-component provider override (optional)
# ARCH_LLM_PROVIDER=openrouter
# DEVSECOPS_LLM_PROVIDER=openrouter
# JUDGE_LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_JUDGE_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_JUDGE_FALLBACK_MODELS=

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_JUDGE_MODEL=llama-3.1-8b-instant


# Optional runtime tuning
DEVSECOPS_LLM_TEMPERATURE=0.7
LLM_JUDGE_MAX_RETRIES=3
LLM_JUDGE_RETRY_DELAY_SEC=2

# Optional: point to a non-default env file
# ENV_FILE=.env

# Optional: point to a non-default Ollama server
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# ── NVIDIA NIM (integrate.api.nvidia.com) ────────────────────────────────────
# Used by architecture / devsecops / cicd / deployment / chaos agents by default
# (see BEST_MODELS in devops_multi_agents/orchestrator.py).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Per-agent provider/model overrides (optional — defaults come from BEST_MODELS):
# ARCH_LLM_PROVIDER=nvidia
# DEVSECOPS_LLM_PROVIDER=nvidia
# CICD_LLM_PROVIDER=nvidia
# DEPLOYMENT_LLM_PROVIDER=nvidia
# CHAOS_LLM_PROVIDER=nvidia
# INCIDENT_LLM_PROVIDER=ollama
# INCIDENT_LLM_MODEL=gpt-oss:120b

# ── MongoDB (shared by deployment + incident response agents) ────────────────
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=CogniOps

# ── GitHub Actions pipeline monitoring ───────────────────────────────────────
# Required when using --monitor-pipelines in run_workflow.py
# Token needs: repo (read) + actions:read scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Repository to monitor in "owner/repo" format
GITHUB_REPO=your-org/your-repo

# ── Incident Response Agent – RAG / MCP settings ─────────────────────────────
# Directory where ChromaDB persists the incident knowledge base
RAG_PERSIST_DIR=devops_multi_agents/outputs/rag_store
# Minimum cosine similarity (0-1) to accept a RAG hit as a valid match
RAG_SIMILARITY_THRESHOLD=0.7

# ── Chaos Engineering Agent ───────────────────────────────────────────────────
# Prometheus HTTP API endpoint (used to collect metrics before/during/after experiments)
PROMETHEUS_URL=http://localhost:9090
# Grafana HTTP API endpoint (used for annotations and Loki log queries)
GRAFANA_URL=http://localhost:3000
# Grafana service-account token (preferred over username/password)
GRAFANA_API_KEY=
# Grafana basic-auth fallback (used when GRAFANA_API_KEY is empty)
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin
# UID of the Loki datasource in Grafana (auto-detected if empty)
LOKI_DATASOURCE_UID=loki
# Execution backend: simulation | docker | kubernetes
CHAOS_BACKEND=simulation
# Set to "true" to log commands without executing them
CHAOS_DRY_RUN=false
# Duration in seconds each failure is held during an experiment
CHAOS_EXPERIMENT_DURATION=60
# Post-recovery observation window in seconds
CHAOS_OBSERVATION_WINDOW=30
# Kubernetes namespace for pod operations (kubernetes backend only)
CHAOS_K8S_NAMESPACE=default
# Map architecture service names to actual Docker container names
# Format: service1=container1,service2=container2
CHAOS_CONTAINER_MAP=hb_electronics=gestiondestock-ui,gestiondestock=gestiondestock-api
